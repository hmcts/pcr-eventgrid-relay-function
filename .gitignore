# Gradle
.gradle/
build/
/gradlew.bat

# Java
*.class

# Package Files — note the negation: gradle-wrapper.jar MUST stay tracked or ./gradlew
# cannot bootstrap on a fresh clone. Order matters, the negation follows the exclusion.
*.jar
!gradle/wrapper/gradle-wrapper.jar
*.war
*.ear
*.rar

# Azure Functions local config (never commit — holds endpoints and keys)
local.settings.json
**/local.settings.json
bin/
obj/

# Local-only material, never committed. `.local/internal_ca_certs.pem` is where a local build looks
# for the PCR ingress private-CA bundle; CI takes it from infrastructure instead via
# CA_BUNDLE_SOURCE. See README "Internal CA trust".
#
# The bare filename is ignored as well as the directory, deliberately: the bundle used to be
# committed at the repo root, and this stops it being re-added there by habit or by `git add -A`.
.local/
internal_ca_certs.pem
**/internal_ca_certs.pem

# Mac
.DS_Store
**/.DS_Store
.fseventsd/
.Spotlight-V100/
.Trashes/
._.Trashes
Thumbs.db

# IntelliJ
.idea/
*.iml
*.iws
*.ipr
/out

# Eclipse
.classpath
.project
.settings/
.factorypath
.checkstyle

.vscode/

# Misc
*~
*.log
*.orig
*.sonar
**/*.env
